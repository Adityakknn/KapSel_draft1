# Sama dengan connection string di packages/shared/.env
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

PORT=4000
NODE_ENV=development

# Ganti dengan string acak panjang (mis. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=8h

# Origin frontend yang boleh akses API dengan cookie (Website Publik & Dashboard Admin), pisahkan koma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Lokasi storage draft surat & folder template .docx (sama dengan wa-bot)
STORAGE_DIR=../../storage
TEMPLATES_DIR=../../templates

# Alamat server internal wa-bot + kunci rahasia - HARUS SAMA PERSIS dengan INTERNAL_API_KEY di apps/wa-bot/.env
INTERNAL_WA_BOT_URL=http://127.0.0.1:4001
INTERNAL_API_KEY=generate-random-string-panjang-di-sini
