# Sama dengan connection string di packages/shared/.env
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Reset sesi chatbot otomatis kalau warga tidak merespons selama N menit
SESSION_TIMEOUT_MINUTES=10

# Lokasi penyimpanan draft dokumen surat & template .docx, relatif terhadap folder apps/wa-bot
STORAGE_DIR=../../storage
TEMPLATES_DIR=../../templates

# Server internal (localhost only) - dipanggil apps/api untuk trigger notifikasi WA
# saat ada pengajuan surat baru lewat website. Harus SAMA PERSIS dengan INTERNAL_API_KEY di apps/api/.env
INTERNAL_PORT=4001
INTERNAL_API_KEY=generate-random-string-panjang-di-sini
