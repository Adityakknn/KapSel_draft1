# Salin file ini jadi ".env" di folder yang sama, isi dengan connection string Supabase kamu:
# Supabase Dashboard > Project Settings > Database > Connection string > URI (mode "Session" / direct connection, port 5432)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Opsional - dipakai oleh `npm run seed` untuk mendaftarkan nomor WA admin penerima notifikasi.
# Format nomor: 62xxxxxxxxxxx (tanpa +, tanpa 0 di depan), pisahkan dengan koma untuk lebih dari satu nomor.
SEED_ADMIN_WA_NUMBERS=
